# Runtime environment
APP_ENV=production

# Database
# These are used by both docker-compose (for the Postgres container) and the app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ev_orchestrator
# When running via docker-compose, DATABASE_URL is set automatically.
# Override it here only for local development without Docker.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_orchestrator
DB_ECHO=false

# Auth
# Generate a long random value for production (at least 32 bytes of entropy).
AUTH_SECRET_KEY=replace-with-strong-random-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=14400
AUTH_PBKDF2_ITERATIONS=390000

# Orchestrator model
ACTOR_MODEL_PATH=models/actor/policy_20251204_120755_e4999_Actor.pth

# Initial admin seed (only used when the DB owners table is empty)
ADMIN_INIT_USER=supsi_admin
ADMIN_INIT_PASSWORD=replace-with-initial-admin-password
ADMIN_INIT_COMPANY=supsi

# ---------------------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------------------
# For Docker Compose, Redis is reached through the service name "redis".
# For local development without Docker, use redis://localhost:6379/0 instead.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDBEAT_REDIS_URL=redis://redis:6379/0
REDBEAT_LOCK_TIMEOUT=300
CELERY_VISIBILITY_TIMEOUT=43200
# Set to true to purge all RedBeat keys and broker queues on scheduler start
CELERY_PURGE_ON_START=false

# ---------------------------------------------------------------------------
# Forecast
# ---------------------------------------------------------------------------
# Directory where trained model artifacts (pkl) are stored.
# In Docker this is set in the Dockerfile; for local dev leave empty to use
# the default (app/services/ev_forecast/artifacts).
FORECASTERS_ARTIFACTS_DIR=
# Override the YAML job manifest path (leave empty for the built-in default)
FORECAST_JOBS_MANIFEST=
# Set to true to remove orphan RedBeat entries whose job IDs are no longer in
# the manifest
FORECAST_PRUNE_ORPHAN_REDBEAT=false
# Maximum age (in days) of a trained forecast artifact before it is retrained
# on the next Celery run. Set to 0 or leave empty to never retrain automatically.
FORECAST_ARTIFACT_MAX_AGE_DAYS=7

# ---------------------------------------------------------------------------
# Base-load forecast (external API)
# ---------------------------------------------------------------------------
# URL of the external load-forecasting API.  When left empty (default), a constant fallback value (120 kW constant) is used instead.
# Horizon and step-size are configured in app/services/orchestrator/constants.py.
BASE_LOAD_FORECAST_API_URL=
